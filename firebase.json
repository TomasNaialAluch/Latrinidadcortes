{
  "hosting": {
    "site": "frigorifico-la-trinidad",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/chat",
        "function": { "functionId": "chatWeb", "region": "southamerica-east1" }
      }
    ]
  }
}
